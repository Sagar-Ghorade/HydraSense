# HydraSense local configuration
#
# Copy this file to `.env` in the repository root and fill in what you need.
# `backend/main.py` loads `.env` on startup; the API also runs with no `.env`.
# Never commit the real `.env`.

# Optional shared PostgreSQL storage for station metadata and prediction
# history (SRS 2.1 / 2.4). Leave empty to keep running from the CSV dataset and
# the local SQLite cache only. Requires `asyncpg`, listed in
# backend/requirements.txt.
POSTGRES_DSN=
